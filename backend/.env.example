# API server port
PORT=3001

# Path to the SQLite database file (relative to backend/ dir or absolute)
# On Azure App Service, point this to the mounted Azure File Share path:
# DB_PATH=/mnt/data/coffee.db
DB_PATH=../data/coffee.db

# Allowed CORS origin (your frontend URL)
# On Azure, set this to your Static Web App URL
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Node environment (development | production)
NODE_ENV=development
